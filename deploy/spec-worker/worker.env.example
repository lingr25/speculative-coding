# Install as /etc/spec-worker.env, chmod 600, owned by root.
# Generate an independent random token (>=32 chars); set the identical token ONLY
# in the control plane's environment. Never copy control-plane LLM provider keys here.
SPEC_WORKER_TOKEN=replace-with-independent-random-64-character-token
SPEC_WORKER_SERVER=wss://control-plane.example.com/api/spec-worker/ws
SPEC_SANDBOX_ROOT=/opt/spec_sandbox
# Default 1: automatically seed missing npm/pnpm/uv dependencies in a controlled
# --ignore-scripts sandbox before running offline --unshare-all gates. Set 0 for strict airgap.
SPEC_AUTO_SEED_DEPS=1
# Comma-separated operator allowlist of Git repository hosts.
SPEC_REPO_HOSTS=github.com,gitlab.com,gitee.com
